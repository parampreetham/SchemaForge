# SchemaForge Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://schemaforge:schemaforge@localhost:5432/schemaforge

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Authentication ─────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ─── AI Providers ───────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
AI_MAX_RETRIES=3
AI_MAX_TOKENS_PER_CHUNK=8000
AI_PIPELINE_BUDGET_USD=50.0

# ─── Validation Target ─────────────────────────────────
AZURE_SQL_CONNECTION_STRING=

# ─── Workers ────────────────────────────────────────────
WORKER_HEARTBEAT_INTERVAL=30
WORKER_ORPHAN_TIMEOUT=120
WORKER_TASK_TIMEOUT=600
WORKER_GRACEFUL_SHUTDOWN_TIMEOUT=60

# ─── Storage ────────────────────────────────────────────
STORAGE_ROOT=./storage

# ─── Application ────────────────────────────────────────
APP_NAME=SchemaForge
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
